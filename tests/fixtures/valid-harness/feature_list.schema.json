{
  "$id": "https://ai-harness.dev/schemas/feature_list.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List",
  "type": "object",
  "required": ["features"],
  "properties": {
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{2}$",
            "description": "Feature ID, e.g. F01, F02"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["planned", "in_progress", "done", "blocked"]
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
