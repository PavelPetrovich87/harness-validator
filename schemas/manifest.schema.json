{
  "$id": "https://ai-harness.dev/schemas/manifest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harness Manifest",
  "description": "Schema for .harness/manifest.json generated by the validator",
  "type": "object",
  "required": ["validated_at", "version", "errors", "warnings", "results"],
  "properties": {
    "validated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of validation"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Harness version (semver)"
    },
    "errors": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of FAIL results"
    },
    "warnings": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of WARN results"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "status", "message"],
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["AST_STRUCTURE", "INSTRUCTION_MODULES", "ARCHITECTURE", "DATA_CONTRACTS", "INTEGRATION"]
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "WARN"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
