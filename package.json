{
  "name": "ai-harness-validator",
  "version": "0.2.0",
  "description": "AST-based validator for AI Harness system",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "harness-setup": "./dist/scripts/setup-harness.js",
    "harness-validate": "./dist/scripts/validate-harness.js",
    "harness-diagnose": "./dist/scripts/diagnose-harness.js",
    "harness-dogfood": "./dist/scripts/dogfood.js"
  },
  "files": [
    "dist/",
    "templates/",
    "schemas/",
    "references/",
    "README.md",
    "SKILL.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "build:clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\" && npm run build",
    "prepublishOnly": "npm run build",
    "generate:agents": "tsx scripts/generate-agents.ts",
    "validate": "tsx scripts/validate-harness.ts",
    "validate:feature-list": "ajv validate -s schemas/feature_list.schema.json -d feature_list.json",
    "validate:knowledge": "ajv validate -s schemas/knowledge_frontmatter.schema.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture": "depcruise src --config .dependency-cruiser.js",
    "setup": "tsx scripts/setup-harness.ts",
    "setup:ci": "tsx scripts/setup-harness.ts --non-interactive",
    "dogfood": "tsx scripts/dogfood.ts",
    "dogfood:all": "tsx scripts/dogfood.ts --all",
    "research:prompt": "tsx scripts/generate-research-prompt.ts",
    "research:apply": "tsx scripts/apply-research.ts",
    "diagnose": "tsx scripts/diagnose-harness.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "glob": "^10.4.5",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^17.4.3",
    "github-actionlint": "^1.7.12",
    "lefthook": "^2.1.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
